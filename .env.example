# Режим работы (True = автономный детерминированный парсер без внешних ключей)
MOCK_MODE=True

# Настройки LLM (при использовании внешнего AI-провайдера для OCR/Vision)
LLM_API_KEY=your_openrouter_or_gigachat_key
LLM_MODEL=deepseek/deepseek-chat

# Интеграция с amoCRM REST API v4
AMOCRM_SUBDOMAIN=your_company
AMOCRM_ACCESS_TOKEN=your_oauth_token

# Интеграция с 1С:УТ / 1С:ERP (OData / HTTP-сервис)
ONEC_API_URL=http://1c.internal.local/ut/hs/spec_import
